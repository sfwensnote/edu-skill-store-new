# 填写你实际服务的接口根地址（通常以 /v1 结束）。不要填写 /chat/completions。
DESIGN_MODEL_URL=
DESIGN_MODEL_NAME=
DESIGN_MODEL_KEY=
TEACHING_MODEL_URL=
TEACHING_MODEL_NAME=
TEACHING_MODEL_KEY=
PORT=5173
# 同源托管前端与后端时启用；GitHub Pages 用仓库变量 API_BASE_URL 指向 HTTPS 后端。
VITE_SERVICE_MODE=server
VITE_API_BASE_URL=
HOST=127.0.0.1
DATABASE_PATH=data/workspace.sqlite
# Docker Compose 同源部署使用的 HTTPS 域名，不含协议或路径。
WORKSHOP_DOMAIN=
# Pages 接入独立后端时填写实际来源，例如 https://sfwensnote.github.io
FRONTEND_ORIGINS=
ALLOW_REGISTRATION=true
# 仅在可信内网使用 HTTP 中转时明确启用；公网部署优先使用 HTTPS 中转。
ALLOW_INSECURE_MODEL_HTTP=false
ENABLE_LEGACY_SEED=false
