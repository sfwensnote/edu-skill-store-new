{
  "name": "educational-skill-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "dev:frontend": "vite --mode preview --host 127.0.0.1",
    "check:source": "node scripts/check-source.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/start.mjs",
    "start:workbench": "tsx server/local-workbench.ts",
    "pc:setup": "tsx scripts/pc-setup.ts",
    "pc:start": "tsx scripts/pc-start.ts",
    "pc:check": "tsx scripts/pc-check.ts",
    "admin:create": "tsx server/admin.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:pc": "node --import tsx --test tests/pc-config.test.ts tests/pc-launch.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "katex": "^0.19.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.9.0",
    "multer": "^2.0.2",
    "pdf-parse": "^2.4.5",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-textarea-autosize": "^8.5.9",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tsx": "^4.23.15",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0"
  }
}
